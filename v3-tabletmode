#!/usr/bin/env bash
# Override the automatic fold detection. Normally you don't need this.
set -u

override=/run/v3-tabletmode/override
state=/run/v3-tabletmode/state

[ -e "$override" ] || {
    echo "v3-tabletmode: daemon isn't running (v3-tabletmode.service)" >&2
    exit 1
}

show() {
    echo "override:    $(cat "$override")"
    echo "tablet mode: $(cat "$state" 2>/dev/null || echo unknown)"
}

case "${1:-toggle}" in
    on|off|auto)
        echo "$1" > "$override"
        ;;
    toggle)
        if [ "$(cat "$override")" = auto ]; then
            echo on > "$override"
        else
            echo auto > "$override"
        fi
        ;;
    status)
        show
        exit 0
        ;;
    *)
        echo "usage: ${0##*/} [auto|on|off|toggle|status]" >&2
        exit 1
        ;;
esac

sleep 1
show
