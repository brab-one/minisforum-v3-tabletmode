#!/usr/bin/env python3
# Tablet mode for the Minisforum V3.
#
# The folio doesn't report its fold state through anything the kernel
# understands - no SW_TABLET_MODE, no USB change, nothing on the GPIOs. It does
# send these on its own HID interface though:
#
#   02 00 00 40   folded back
#   02 00 00 08   opened again
#
# Nothing maps them to input events, so we read hidraw ourselves and push a
# uinput switch that KWin actually listens to.

import fcntl
import glob
import os
import select
import struct
import time

RUNDIR = "/run/v3-tabletmode"
OVERRIDE = RUNDIR + "/override"
STATE = RUNDIR + "/state"

FOLIO = "0003:000005AF:0000326A"          # USB 05af:326a
FOLDED = bytes((0x02, 0x00, 0x00, 0x40))
OPENED = bytes((0x02, 0x00, 0x00, 0x08))

UI_SET_EVBIT = 0x40045564
UI_SET_SWBIT = 0x4004556D
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502
UI_DEV_SETUP = 0x405C5503
EV_SYN, EV_SW = 0x00, 0x05
SYN_REPORT, SW_TABLET_MODE = 0x00, 0x01
# timeval is two longs here, so 24 bytes - "<l" would give 4 and uinput EINVALs
EVENT = "<qqHHi"


def new_switch():
    fd = os.open("/dev/uinput", os.O_RDWR)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_SW)
    fcntl.ioctl(fd, UI_SET_SWBIT, SW_TABLET_MODE)
    fcntl.ioctl(fd, UI_DEV_SETUP,
                struct.pack("<4H80sI", 0x06, 0x1d6b, 1, 1,
                            b"V3 Tablet Mode Switch", 0))
    fcntl.ioctl(fd, UI_DEV_CREATE)
    return fd


def send(fd, value):
    now = time.time()
    sec, usec = int(now), int(now % 1 * 1e6)
    os.write(fd, struct.pack(EVENT, sec, usec, EV_SW, SW_TABLET_MODE, value))
    os.write(fd, struct.pack(EVENT, sec, usec, EV_SYN, SYN_REPORT, 0))


def folio_nodes():
    nodes = []
    for path in sorted(glob.glob("/dev/hidraw*")):
        uevent = "/sys/class/hidraw/%s/device/uevent" % os.path.basename(path)
        try:
            with open(uevent) as f:
                if ("HID_ID=" + FOLIO) in f.read():
                    nodes.append(path)
        except OSError:
            pass
    return nodes


def override():
    try:
        with open(OVERRIDE) as f:
            val = f.read().strip().lower()
    except OSError:
        return "auto"
    return val if val in ("auto", "on", "off") else "auto"


def main():
    os.makedirs(RUNDIR, exist_ok=True)
    os.chmod(RUNDIR, 0o777)
    if not os.path.exists(OVERRIDE):
        with open(OVERRIDE, "w") as f:
            f.write("auto\n")
    os.chmod(OVERRIDE, 0o666)

    switch = None
    folded = False
    current = None
    fds = {}
    scanned = 0.0

    while True:
        if not fds and time.time() - scanned > 2:
            scanned = time.time()
            for path in folio_nodes():
                try:
                    fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
                except OSError:
                    pass
            if fds:
                print("folio on", " ".join(sorted(fds.values())), flush=True)

        if fds:
            ready, _, _ = select.select(list(fds), [], [], 0.5)
            for fd in ready:
                try:
                    report = os.read(fd, 64)
                except OSError:
                    os.close(fd)
                    del fds[fd]
                    folded = False        # gone -> let KWin's own detach handling win
                    print("folio disconnected", flush=True)
                    continue
                if report == FOLDED:
                    folded = True
                    print("folded", flush=True)
                elif report == OPENED:
                    folded = False
                    print("opened", flush=True)
        else:
            time.sleep(0.5)

        mode = override()
        want = True if mode == "on" else False if mode == "off" else folded
        if want == current:
            continue

        # drop the device entirely when we're not asserting tablet mode, rather
        # than reporting 0 - otherwise we fight the detach detection
        if want and switch is None:
            switch = new_switch()
            time.sleep(0.3)               # udev needs a moment before the event
            send(switch, 1)
        elif not want and switch is not None:
            send(switch, 0)
            time.sleep(0.1)
            fcntl.ioctl(switch, UI_DEV_DESTROY)
            os.close(switch)
            switch = None

        current = want
        try:
            with open(STATE, "w") as f:
                f.write("on\n" if want else "off\n")
            os.chmod(STATE, 0o644)
        except OSError:
            pass
        print("tablet mode", "on" if want else "off", flush=True)


main()
